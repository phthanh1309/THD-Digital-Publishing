generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PublicationStatus {
  draft
  published
  archived
}

model Publication {
  id            String            @id
  slug          String            @unique
  title         String
  subtitle      String            @default("")
  year          Int
  description   String
  cover         String
  pdf           String            @default("")
  pageCount     Int
  status        PublicationStatus @default(draft)
  author        String
  editor        String            @default("")
  language      String            @default("")
  publishedAt   String            @default("")
  allowDownload Boolean           @default(false)
  allowPrint    Boolean           @default(false)
  allowShare    Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  likes Like[]
  favorites Favorite[]
  comments Comment[]
  readingHistory ReadingHistory[]
  featureOverrides PublicationFeature[]
  featureAuditLogs FeatureSettingAuditLog[]
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  username      String    @unique
  email         String?   @unique
  emailVerified DateTime?
  passwordHash  String
  image         String?
  bio           String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  likes Like[]
  favorites Favorite[]
  comments Comment[]
  readingHistory ReadingHistory[]
  featureAuditLogs FeatureSettingAuditLog[]
}
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
model Like {
  id            String   @id @default(cuid())
  userId        String
  publicationId String
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@unique([userId, publicationId])
}
model Favorite {
  id            String   @id @default(cuid())
  userId        String
  publicationId String
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@unique([userId, publicationId])
}
model Comment {
  id            String   @id @default(cuid())
  content       String
  userId        String
  publicationId String
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@index([publicationId, createdAt])
}
model ReadingHistory {
  id            String   @id @default(cuid())
  userId        String
  publicationId String
  lastReadAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@unique([userId, publicationId])
}

enum FeatureScope {
  GLOBAL
  GLOBAL_AND_PUBLICATION
}

enum FeatureOverrideState {
  INHERIT
  ENABLED
  DISABLED
}

enum FeatureAuditScope {
  GLOBAL
  PUBLICATION
}

enum FeatureAuditAction {
  SET_GLOBAL
  SET_OVERRIDE
  RESET_OVERRIDE
}

model FeatureFlag {
  key         String       @id
  name        String
  description String       @default("")
  enabled     Boolean      @default(true)
  scope       FeatureScope @default(GLOBAL)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  publicationOverrides PublicationFeature[]

  @@index([scope])
}

model PublicationFeature {
  id            String               @id @default(cuid())
  featureKey    String
  publicationId String
  state         FeatureOverrideState @default(INHERIT)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  feature     FeatureFlag @relation(fields: [featureKey], references: [key], onDelete: Cascade, onUpdate: Cascade)
  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([featureKey, publicationId])
  @@index([publicationId])
  @@index([featureKey, state])
}

model FeatureSettingAuditLog {
  id            String               @id @default(cuid())
  actorId       String?
  featureKey    String
  scope         FeatureAuditScope
  publicationId String?
  action        FeatureAuditAction
  oldValue      Json?
  newValue      Json?
  createdAt     DateTime             @default(now())

  actor       User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)
  publication Publication? @relation(fields: [publicationId], references: [id], onDelete: SetNull)

  @@index([featureKey, createdAt])
  @@index([publicationId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
}